# =============================================================================
# FactBot .env.example — salin ke .env di VPS (/opt/factbot/.env), chmod 600.
# JANGAN PERNAH di-commit. Isi semua secret sebelum `docker compose up`.
# =============================================================================

# ---- App ----
APP_ENV=production
LOG_LEVEL=INFO

# ---- Meta / Instagram (App Dashboard → App Settings → Basic) ----
META_APP_ID=
META_APP_SECRET=
META_APP_SECRET_2=
META_SKIP_SIGNATURE_CHECK=false
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Verify token webhook — HARUS sama persis dgn yg diinput di Meta App Dashboard
# (callback URL: https://factbot.tech/webhooks/meta)
META_VERIFY_TOKEN=CHANGE_ME_verify_token

# ---- Instagram Business ----
IG_BUSINESS_ID=
IG_BASIC_TOKEN=
IG_USER_TOKEN=

# ---- LLM via Parkee proxy (OpenAI-compatible) ----
PARKEE_PROXY_URL=
PARKEE_MODEL=deepseek-v3
PARKEE_PROXY_KEY=

# ---- FactBot web API (publish hasil laporan) ----
FACTBOT_API_URL=https://factbot.tech/api/v1/reports
FACTBOT_API_KEY=

# ---- Database ----
# VPS: PostgreSQL 17 milik stack (service factbot_db di Docker network).
# Ganti user/password/db sesuai kredensial dari pemilik stack.
DATABASE_URL=postgresql+asyncpg://factbot:CHANGE_ME@factbot_db:5432/factbot
# Fallback MVP (tanpa worker terpisah / in-process worker):
# DATABASE_URL=sqlite:///./data/factbot.db

# ---- Whisper / video ----
WHISPER_MODEL=small            # base (cepat) | small (akurat) — 4 vCPU cukup
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=id
MAX_VIDEO_SECONDS=180

# ---- Worker (bot-worker) ----
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=15
WORKER_HEARTBEAT_STALE_SECONDS=60

# ---- Compose interpolation (dibaca docker compose, TIDAK masuk container logic) ----
# Nama Docker network milik stack teman (nginx/web/db). Cek: docker network ls
EXTERNAL_NETWORK=factbot_net
IMAGE_TAG=latest
LLM_TIMEOUT_SECONDS=60
